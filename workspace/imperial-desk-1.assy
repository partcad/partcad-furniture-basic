# All the arithmetic is in inches and the locations are in millimetres.
#
# The desk stands on the XY plane, its length along X and its depth along Y,
# with the top's front-left corner over the origin. Every component is modelled
# in its stock's frame -- the width along X, the length along Y, the thickness
# along Z, from the origin -- and is turned into place here.
{% set mm = 25.4 %}
{% set inset = 2.0 %}                    {# how far the legs sit in from the edge of the top #}
{% set top_thickness = 0.75 - 1/32 %}    {# 3/4 in. nominal plywood #}
{% set post = 3.5 %}                     {# a 4x4 #}
{% set apron_thickness = 1.5 %}          {# a 2x6, on edge #}
{% set apron_depth = 5.5 %}
{% set leg_length = param_height - top_thickness %}
{% set x_apron = param_length - 2 * inset - 2 * post %}
{% set y_apron = param_width - 2 * inset - 2 * post %}
{# Refuse a desk the pieces cannot form: a top too small to span the legs and
   an apron between them, or legs too short for an apron under the top. The
   template has no way to raise an error of its own, so it calls a function
   whose name is the message, and rendering stops there. #}
{% if x_apron <= 0 or y_apron <= 0 %}
{{ imperial_desk_1_length_and_width_must_be_more_than_11_in() }}
{% endif %}
{% if leg_length < apron_depth %}
{{ imperial_desk_1_height_must_be_at_least_6_22_in() }}
{% endif %}

links:
  # The legs stand up: the post's length (Y) turned onto Z.
  {% for x in [inset, param_length - inset - post] %}
  {% for y in [inset, param_width - inset - post] %}
  - part: leg
    name: leg
    location: [[{{ x * mm }}, {{ (y + post) * mm }}, 0], [1, 0, 0], 90]
    params:
      length: {{ leg_length }}
  {% endfor %}
  {% endfor %}

  # The front and back aprons run along X between the legs, flush with the legs'
  # outer faces and with their tops under the top. The board's length (Y) goes
  # to X, its width (X) up to Z and its thickness (Z) to Y.
  {% for y in [inset, param_width - inset - apron_thickness] %}
  - part: apron
    name: apron-x
    location: [[{{ (inset + post) * mm }}, {{ y * mm }}, {{ (leg_length - apron_depth) * mm }}], [-1, -1, -1], 120]
    params:
      length: {{ x_apron }}
  {% endfor %}

  # The side aprons run along Y: the board's width (X) goes up to Z and its
  # thickness (Z) to X.
  {% for x in [inset + apron_thickness, param_length - inset] %}
  - part: apron
    name: apron-y
    location: [[{{ x * mm }}, {{ (inset + post) * mm }}, {{ (leg_length - apron_depth) * mm }}], [0, 1, 0], -90]
    params:
      length: {{ y_apron }}
  {% endfor %}

  # The top lies on the legs, its length (Y) turned onto X.
  - part: top
    name: top
    location: [[{{ param_length * mm }}, 0, {{ leg_length * mm }}], [0, 0, 1], 90]
    params:
      width: {{ param_width }}
      length: {{ param_length }}

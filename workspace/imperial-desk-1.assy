# All the arithmetic is in inches.
#
# Every component is joined through the ports it declares, so nothing here is a
# coordinate. The desk is built from its top: it is in the top's frame, the
# length along Y and the depth along X, standing down from the top's underside
# at Z = 0. The two ends are the same frame (see 'imperial-desk-1/side'), the
# right one turned half a turn, and the long aprons join the left one.
{% set inset = 2.0 %}                    {# how far the legs sit in from the edge of the top, as its 'map:' says #}
{% set top_thickness = 0.75 - 1/32 %}    {# 3/4 in. nominal plywood #}
{% set post = 3.5 %}                     {# a 4x4 #}
{% set apron_depth = 5.5 %}              {# a 2x6, on edge #}
{% set leg_length = param_height - top_thickness %}
{% set x_apron = param_length - 2 * inset - 2 * post %}
{% set y_apron = param_width - 2 * inset - 2 * post %}
{# Refuse a desk the pieces cannot form: a top too small to span the legs and
   an apron between them, or legs too short for an apron under the top. The
   template has no way to raise an error of its own, so it calls a function
   whose name is the message, and rendering stops there. #}
{% if x_apron <= 0 or y_apron <= 0 %}
{{ imperial_desk_1_length_and_width_must_be_more_than_11_in() }}
{% endif %}
{% if leg_length < apron_depth %}
{{ imperial_desk_1_height_must_be_at_least_6_22_in() }}
{% endif %}

links:
  - part: top
    name: top
    params:
      width: {{ param_width }}
      length: {{ param_length }}

  # The two ends, each standing on the top by its first leg.
  {% for name, corner in [("left-side", "front-left-leg"), ("right-side", "back-right-leg")] %}
  - assembly: imperial-desk-1/side
    name: {{ name }}
    params:
      leg: {{ leg_length }}
      apron: {{ y_apron }}
    connectPorts:
      with: leg-top
      name: top
      to: {{ corner }}
      how:
        # Set against it by hand.
        pushForceMax: 20
  {% endfor %}

  # The front and back aprons run between the ends, flush with the legs'
  # outer faces.
  {% for name, rail, end in [("front-apron", "rail-1", "end-b"), ("back-apron", "rail-2", "end-a")] %}
  - part: apron
    name: {{ name }}
    params:
      length: {{ x_apron }}
    connectPorts:
      with: {{ end }}
      name: left-side
      to: {{ rail }}
      how:
        # Set against it by hand.
        pushForceMax: 20
  {% endfor %}
